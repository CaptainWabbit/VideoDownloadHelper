{
  "name": "video-download-helper",
  "version": "3.2.1",
  "private": true,
  "description": "Repository root for the Simple Video Download Helper browser extension. The extension and its tooling live in the video-url-parser/ directory; the scripts below simply delegate there so they can be run from the repository root.",
  "scripts": {
    "postinstall": "cd video-url-parser && npm install",
    "test": "cd video-url-parser && npm test",
    "coverage": "cd video-url-parser && npm run coverage",
    "lint": "cd video-url-parser && npm run lint",
    "lint:fix": "cd video-url-parser && npm run lint:fix",
    "format": "cd video-url-parser && npm run format",
    "format:check": "cd video-url-parser && npm run format:check",
    "check": "cd video-url-parser && npm run check",
    "build": "cd video-url-parser && npm run build",
    "dev": "cd video-url-parser && npm run dev",
    "watch": "cd video-url-parser && npm run watch",
    "package": "cd video-url-parser && npm run package"
  },
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DoctorLai/VideoDownloadHelper"
  },
  "keywords": [
    "video",
    "download video",
    "video url",
    "save video",
    "chrome extension",
    "browser extension"
  ],
  "author": "justyy <dr.zhihua.lai@gmail.com> (https://helloacm.com)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/DoctorLai/VideoDownloadHelper/issues"
  },
  "homepage": "https://github.com/DoctorLai/VideoDownloadHelper#readme"
}